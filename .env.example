# ---------------------------------------------------------------- Delphi World

# Required for agents to actually think. Without it the world runs in
# simulation mode: agents walk, hire and move tasks on a scripted plan.
ANTHROPIC_API_KEY=

# Optional model overrides. Defaults: Opus 5 for executives, Sonnet 5 for
# workers, Haiku 4.5 for interns.
# DELPHI_MODEL_EXECUTIVE=claude-opus-5
# DELPHI_MODEL_WORKER=claude-sonnet-5
# DELPHI_MODEL_INTERN=claude-haiku-4-5

# Force simulation mode even when a key is present (useful for demos).
# DELPHI_WORLD_SIMULATE=1

# Safety rails.
# DELPHI_MAX_AGENTS=40
# DELPHI_MAX_COMPANIES=12
# DELPHI_MAX_TOOL_ITERATIONS=8
# DELPHI_MAX_TASK_TURNS=12

# ------------------------------------------------------------------- storage
# supabase | google-drive | local. Defaults to whichever is configured.
# DELPHI_STORAGE_PROVIDER=supabase
# DELPHI_STORAGE_BUCKET=delphi-world
# DELPHI_LOCAL_STORAGE_DIR=.delphi/files
# DELPHI_WORLD_STATE_FILE=.delphi/world.json

# Google Drive (scope: https://www.googleapis.com/auth/drive.file)
# GOOGLE_DRIVE_CLIENT_ID=
# GOOGLE_DRIVE_CLIENT_SECRET=
# GOOGLE_DRIVE_REFRESH_TOKEN=
# GOOGLE_DRIVE_ROOT_FOLDER_ID=

# ------------------------------------------------------- existing Delphi app
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
PERPLEXITY_API_KEY=
